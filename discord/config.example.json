{
  "allowed_user_ids": ["<USER_ID>"],
  "allowed_guild_ids": ["<GUILD_ID>"],
  "chat_channels": [
    "<CHAT_CHANNEL_ID>",
    { "id": "<AUTONOMOUS_CHAT_CHANNEL_ID>", "per_day": 2 },
    {
      "id": "<TOPIC_CHAT_CHANNEL_ID>",
      "per_day": 1,
      "topic": "<CHAT_TOPIC>"
    }
  ],
  "request_channels": [
    "<ARCHIVE_FORUM_ID>",
    "<REPLY_ONLY_CHANNEL_ID>",
    {
      "id": "<EXAMPLE_REPLY_ONLY_CHANNEL_ID>",
      "model": "claude-opus-5-5",
      "effort": "medium"
    }
  ],
  "archive_forum_id": "<ARCHIVE_FORUM_ID>",
  "archive_repository": {
    "owner": "<GITHUB_OWNER>",
    "repo": "<GITHUB_REPO_NAME>",
    "token": "<GITHUB_PAT_WITH_CONTENTS_ISSUES_PULL_REQUESTS_WRITE>"
  },
  "chat": {
    "model": "claude-haiku-5-5",
    "effort": "medium",
    "router_model": "claude-haiku-5-5",
    "sdk_max_turns": 10,
    "history_hours": 12,
    "history_max_lines": 500,
    "line_max_chars": 2000,
    "failure_notice": "-# 대답을 할 수 없어요",
    "scheduler_interval_seconds": 30,
    "turn_delay_seconds": 2,
    "max_turns": 6
  },
  "attachments": {
    "text_max_kb": 200,
    "text_preview_chars": 800,
    "image_captions_max": 200
  },
  "links": {
    "preview_retries": 3,
    "preview_retry_seconds": 2,
    "description_max_chars": 1000
  },
  "reminders": {
    "timezone_offset_hours": 9,
    "max_days": 7,
    "check_seconds": 20,
    "repeat_grace_minutes": 5,
    "late_minutes": 2
  },
  "tools": {
    "channel_history_max": 50,
    "server_channels_max": 100
  },
  "summary": {
    "raw_hours": 2,
    "model": "claude-haiku-4-5",
    "max_chars": 2000,
    "batch_min_lines": 30,
    "batch_max_lines": 150,
    "batch_max_chars": 20000,
    "flush_minutes": 60,
    "max_attempts": 3
  },
  "memory": {
    "prompt_max_items": 5,
    "prompt_max_chars": 1500,
    "search_max_results": 10,
    "persona_prompt_max_items": 5,
    "persona_prompt_max_chars": 1000,
    "persona_setting_max_chars": 1000
  },
  "agents": [
    {
      "role": "director",
      "name": "rio",
      "korean_name": "리오",
      "token": "<RIO_TOKEN>",
      "tools": ["Read", "WebSearch", "WebFetch"]
    },
    {
      "role": "researcher",
      "name": "nico",
      "korean_name": "니코",
      "token": "<NICO_TOKEN>",
      "tools": ["Read", "WebSearch", "WebFetch"]
    },
    {
      "role": "worker",
      "name": "jelly",
      "korean_name": "젤리",
      "token": "<JELLY_TOKEN>",
      "tools": ["Read", "WebSearch", "WebFetch"]
    },
    {
      "role": "reviewer",
      "name": "ricky",
      "korean_name": "리키",
      "token": "<RICKY_TOKEN>",
      "tools": ["Read", "WebSearch", "WebFetch"]
    },
    {
      "role": "documenter",
      "name": "pepper",
      "korean_name": "페퍼",
      "token": "<PEPPER_TOKEN>",
      "tools": ["Read", "WebSearch", "WebFetch"]
    },
    {
      "role": "assistant",
      "name": "buddy",
      "korean_name": "버디",
      "token": "<BUDDY_TOKEN>",
      "tools": ["Read", "WebSearch", "WebFetch"]
    }
  ]
}

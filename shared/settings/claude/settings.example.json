{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "buddy",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "sandbox": {
    "enabled": true
  },
  "statusLine": {
    "type": "command",
    "command": "\"<PYTHON>\" \"<NESTLAB>/hooks/show_statusline.py\"",
    "padding": 0,
    "statusMessage": "Nestlab 에이전트 상태줄 이름 표시"
  },
  "permissions": {
    "additionalDirectories": ["~/.claude", "~/.codex", "<TEMP>", "<NODEBASE>"],
    "allow": [
      "WebSearch",
      "WebFetch",
      "Read(~/.claude/**)",
      "Read(~/.codex/**)",
      "Edit(./**)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git blame *)",
      "Bash(git ls-files *)",
      "Bash(git grep *)",
      "Bash(git describe *)",
      "Bash(stat *)",
      "Bash(date *)",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash",
      "Bash(python -m unittest *)",
      "Bash(python3 -m unittest *)",
      "Bash(py -m unittest *)",
      "Bash(python hooks/tests/test_*.py)",
      "Bash(python -B tools/tests/test_set_hooks.py)",
      "Bash(python tools/check_doc_rule.py)",
      "Bash(python tools/set_skills.py check)",
      "Bash(python ../tools/check_doc_rule.py)",
      "Bash(python ../tools/set_skills.py check)",
      "Bash(git shortlog *)",
      "Bash(git cat-file *)",
      "Bash(git ls-tree *)",
      "Bash(git rev-list *)",
      "Bash(git merge-base *)",
      "Bash(git show-ref *)",
      "Bash(git for-each-ref *)",
      "Bash(git name-rev *)",
      "Bash(git reflog *)",
      "Bash(git stash list *)",
      "Bash(git stash show *)",
      "Bash(git remote -v)",
      "Bash(git remote show *)",
      "Bash(git config --get *)",
      "Bash(git config --list *)"
    ],
    "deny": [
      "Agent(fork)",
      "Bash(cd *)",
      "Bash(pushd *)",
      "PowerShell(cd *)",
      "PowerShell(Set-Location *)",
      "PowerShell(sl *)",
      "PowerShell(chdir *)",
      "PowerShell(Push-Location *)",
      "Bash(git -c *)",
      "Bash(git rebase *)",
      "Bash(git revert *)",
      "Bash(git cherry-pick *)",
      "Bash(git commit --amend *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Bash(git checkout -f *)",
      "Bash(git checkout --force *)",
      "Bash(git checkout -- *)",
      "Bash(git switch -f *)",
      "Bash(git switch --force *)",
      "Bash(git switch --discard-changes *)",
      "Bash(git rm -f *)",
      "Bash(git rm --force *)",
      "Bash(git worktree remove -f *)",
      "Bash(git worktree remove --force *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(git reflog expire *)",
      "Bash(git reflog delete *)",
      "Bash(git prune *)",
      "Bash(git gc --prune*)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git push -f *)",
      "Bash(git push --force*)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/secrets/**)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.codex/auth.json.bak)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(~/.codex/auth.json*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"<PYTHON>\" \"<NESTLAB>/hooks/load_agent.py\" --default-role buddy",
            "statusMessage": "Nestlab 메인 에이전트 역할 및 공통 지침"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"<PYTHON>\" \"<NESTLAB>/hooks/load_agent.py\"",
            "statusMessage": "Nestlab 서브 에이전트 역할 및 공통 지침"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Edit|Write|NotebookEdit|Bash|PowerShell|Read|Grep|Glob|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"<PYTHON>\" \"<NESTLAB>/hooks/check_tool_use.py\" --runner claude",
            "timeout": 10,
            "statusMessage": "Nestlab 승인, 입력, 쓰기 범위 검사"
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "\"<PYTHON>\" \"<NESTLAB>/hooks/save_handback_report.py\"",
            "timeout": 10,
            "statusMessage": "Nestlab 조사 결과 저장"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"<PYTHON>\" \"<NESTLAB>/hooks/allow_approved_request.py\" --runner claude",
            "timeout": 10,
            "statusMessage": "Nestlab 승인 창 자동 허용"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"<PYTHON>\" \"<NESTLAB>/hooks/save_subagent_result.py\" --runner claude",
            "timeout": 10,
            "statusMessage": "Nestlab 결과 원문 저장"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"<PYTHON>\" \"<NESTLAB>/tools/check_doc_rule.py\" --hook",
            "timeout": 30,
            "statusMessage": "Nestlab 지침 검사"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"<PYTHON>\" \"<NESTLAB>/hooks/return_research_path.py\" --runner claude",
            "timeout": 10,
            "statusMessage": "Nestlab 조사 문서 경로 반환"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"<PYTHON>\" \"<NESTLAB>/hooks/check_invalid_response.py\" --runner claude",
            "timeout": 10,
            "statusMessage": "Nestlab 사건 감지"
          },
          {
            "type": "command",
            "command": "\"<PYTHON>\" \"<NESTLAB>/hooks/check_workflow_response.py\" --runner claude",
            "timeout": 10,
            "statusMessage": "Nestlab 응답 검사"
          }
        ]
      }
    ]
  }
}

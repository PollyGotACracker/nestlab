# `prompt` 줄: 승인 요청
# `forbidden` 줄: 금지
# 규칙이 없는 명령: 허용
# sandbox_mode = "danger-full-access"라 모든 명령에 적용된다.

prefix_rule(pattern=["git", "commit"], decision="prompt")
prefix_rule(pattern=["git", "push"], decision="prompt")
prefix_rule(pattern=["git", "rm"], decision="prompt")
prefix_rule(pattern=["git", "mv"], decision="prompt")
prefix_rule(pattern=["rm"], decision="prompt")
prefix_rule(pattern=["rmdir"], decision="prompt")

prefix_rule(pattern=["git", "add"], decision="forbidden")
prefix_rule(pattern=["git", "checkout"], decision="forbidden")
prefix_rule(pattern=["git", "switch"], decision="forbidden")
prefix_rule(pattern=["git", "restore"], decision="forbidden")
prefix_rule(pattern=["git", "stash"], decision="forbidden")
prefix_rule(pattern=["git", "tag"], decision="forbidden")
prefix_rule(pattern=["git", "merge"], decision="forbidden")
prefix_rule(pattern=["git", "rebase"], decision="forbidden")
prefix_rule(pattern=["git", "reset"], decision="forbidden")
prefix_rule(pattern=["git", "revert"], decision="forbidden")
prefix_rule(pattern=["git", "cherry-pick"], decision="forbidden")
prefix_rule(pattern=["git", "clean"], decision="forbidden")
prefix_rule(pattern=["git", "pull"], decision="forbidden")
prefix_rule(pattern=["git", "fetch"], decision="forbidden")
prefix_rule(pattern=["git", "apply"], decision="forbidden")
prefix_rule(pattern=["git", "am"], decision="forbidden")
prefix_rule(pattern=["git", "init"], decision="forbidden")
prefix_rule(pattern=["git", "clone"], decision="forbidden")
prefix_rule(pattern=["git", "submodule"], decision="forbidden")
prefix_rule(pattern=["git", "worktree"], decision="forbidden")
prefix_rule(pattern=["git", "gc"], decision="forbidden")
prefix_rule(pattern=["git", "prune"], decision="forbidden")
prefix_rule(pattern=["git", "branch", "-d"], decision="forbidden")
prefix_rule(pattern=["git", "branch", "-D"], decision="forbidden")
prefix_rule(pattern=["git", "branch", "-m"], decision="forbidden")
prefix_rule(pattern=["git", "branch", "-M"], decision="forbidden")
prefix_rule(pattern=["git", "branch", "-c"], decision="forbidden")
prefix_rule(pattern=["git", "branch", "-C"], decision="forbidden")
prefix_rule(pattern=["git", "branch", "--delete"], decision="forbidden")
prefix_rule(pattern=["git", "branch", "--move"], decision="forbidden")
prefix_rule(pattern=["git", "branch", "--copy"], decision="forbidden")
prefix_rule(pattern=["git", "branch", "--force"], decision="forbidden")
prefix_rule(pattern=["git", "branch", "--set-upstream-to"], decision="forbidden")
prefix_rule(pattern=["git", "branch", "--unset-upstream"], decision="forbidden")
prefix_rule(pattern=["git", "remote", "add"], decision="forbidden")
prefix_rule(pattern=["git", "remote", "remove"], decision="forbidden")
prefix_rule(pattern=["git", "remote", "rename"], decision="forbidden")
prefix_rule(pattern=["git", "remote", "set-url"], decision="forbidden")

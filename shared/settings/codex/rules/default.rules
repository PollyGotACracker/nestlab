# `prompt` 줄: 승인 요청
# `forbidden` 줄: 금지
# 규칙이 없는 명령: 허용
# 규칙에 맞는 명령은 sandbox_mode와 무관하게 이 결정을 따른다. 규칙이 없는 명령은 샌드박스 안에서 실행된다.
# 여러 규칙이 맞으면 가장 엄격한 결정(forbidden > prompt > allow)을 적용한다.

prefix_rule(pattern=["git", "commit"], decision="prompt")
prefix_rule(pattern=["git", "add"], decision="prompt")
prefix_rule(pattern=["git", "push"], decision="prompt")
prefix_rule(pattern=["git", "rm"], decision="prompt")
prefix_rule(pattern=["git", "mv"], decision="prompt")
prefix_rule(pattern=["git", "checkout"], decision="prompt")
prefix_rule(pattern=["git", "switch"], decision="prompt")
prefix_rule(pattern=["git", "stash", "push"], decision="prompt")
prefix_rule(pattern=["git", "stash", "pop"], decision="prompt")
prefix_rule(pattern=["git", "stash", "apply"], decision="prompt")
prefix_rule(pattern=["git", "stash", "save"], decision="prompt")
prefix_rule(pattern=["git", "stash", "branch"], decision="prompt")
prefix_rule(pattern=["git", "tag"], decision="prompt")
prefix_rule(pattern=["git", "pull"], decision="prompt")
prefix_rule(pattern=["git", "fetch"], decision="prompt")
prefix_rule(pattern=["git", "apply"], decision="prompt")
prefix_rule(pattern=["git", "merge"], decision="prompt")
prefix_rule(pattern=["git", "am"], decision="prompt")
prefix_rule(pattern=["git", "init"], decision="prompt")
prefix_rule(pattern=["git", "clone"], decision="prompt")
prefix_rule(pattern=["git", "submodule"], decision="prompt")
prefix_rule(pattern=["git", "worktree"], decision="prompt")
prefix_rule(pattern=["git", "gc"], decision="prompt")
prefix_rule(pattern=["git", "reset"], decision="prompt")
prefix_rule(pattern=["git", "-C"], decision="prompt")
prefix_rule(pattern=["git", "-c"], decision="prompt")
prefix_rule(pattern=["git", "update-index"], decision="prompt")
prefix_rule(pattern=["git", "read-tree"], decision="prompt")
prefix_rule(pattern=["git", "checkout-index"], decision="prompt")
prefix_rule(pattern=["git", "sparse-checkout"], decision="prompt")
prefix_rule(pattern=["git", "update-ref"], decision="prompt")
prefix_rule(pattern=["git", "symbolic-ref"], decision="prompt")
prefix_rule(pattern=["git", "replace"], decision="prompt")
prefix_rule(pattern=["git", "notes"], decision="prompt")
prefix_rule(pattern=["git", "config", "--add"], decision="prompt")
prefix_rule(pattern=["git", "config", "--unset"], decision="prompt")
prefix_rule(pattern=["git", "config", "--unset-all"], decision="prompt")
prefix_rule(pattern=["git", "config", "--replace-all"], decision="prompt")
prefix_rule(pattern=["git", "config", "--rename-section"], decision="prompt")
prefix_rule(pattern=["git", "config", "--remove-section"], decision="prompt")
prefix_rule(pattern=["git", "config", "--edit"], decision="prompt")
prefix_rule(pattern=["git", "branch", "-d"], decision="prompt")
prefix_rule(pattern=["git", "branch", "-D"], decision="prompt")
prefix_rule(pattern=["git", "branch", "-m"], decision="prompt")
prefix_rule(pattern=["git", "branch", "-M"], decision="prompt")
prefix_rule(pattern=["git", "branch", "-c"], decision="prompt")
prefix_rule(pattern=["git", "branch", "-C"], decision="prompt")
prefix_rule(pattern=["git", "branch", "--delete"], decision="prompt")
prefix_rule(pattern=["git", "branch", "--move"], decision="prompt")
prefix_rule(pattern=["git", "branch", "--copy"], decision="prompt")
prefix_rule(pattern=["git", "branch", "--force"], decision="prompt")
prefix_rule(pattern=["git", "branch", "--set-upstream-to"], decision="prompt")
prefix_rule(pattern=["git", "branch", "--unset-upstream"], decision="prompt")
prefix_rule(pattern=["git", "remote", "add"], decision="prompt")
prefix_rule(pattern=["git", "remote", "remove"], decision="prompt")
prefix_rule(pattern=["git", "remote", "rename"], decision="prompt")
prefix_rule(pattern=["git", "remote", "set-url"], decision="prompt")
prefix_rule(pattern=["rm"], decision="prompt")
prefix_rule(pattern=["rmdir"], decision="prompt")

prefix_rule(pattern=["sed"], decision="forbidden")
prefix_rule(pattern=["cd"], decision="forbidden")
prefix_rule(pattern=["git", "rebase"], decision="forbidden")
prefix_rule(pattern=["git", "revert"], decision="forbidden")
prefix_rule(pattern=["git", "cherry-pick"], decision="forbidden")
prefix_rule(pattern=["git", "commit", "--amend"], decision="forbidden")
prefix_rule(pattern=["git", "reset", "--hard"], decision="forbidden")
prefix_rule(pattern=["git", "clean"], decision="forbidden")
prefix_rule(pattern=["git", "restore"], decision="forbidden")
prefix_rule(pattern=["git", "checkout", "-f"], decision="forbidden")
prefix_rule(pattern=["git", "checkout", "--force"], decision="forbidden")
prefix_rule(pattern=["git", "checkout", "--"], decision="forbidden")
prefix_rule(pattern=["git", "switch", "-f"], decision="forbidden")
prefix_rule(pattern=["git", "switch", "--force"], decision="forbidden")
prefix_rule(pattern=["git", "switch", "--discard-changes"], decision="forbidden")
prefix_rule(pattern=["git", "rm", "-f"], decision="forbidden")
prefix_rule(pattern=["git", "rm", "--force"], decision="forbidden")
prefix_rule(pattern=["git", "worktree", "remove", "-f"], decision="forbidden")
prefix_rule(pattern=["git", "worktree", "remove", "--force"], decision="forbidden")
prefix_rule(pattern=["git", "stash", "drop"], decision="forbidden")
prefix_rule(pattern=["git", "stash", "clear"], decision="forbidden")
prefix_rule(pattern=["git", "reflog", "expire"], decision="forbidden")
prefix_rule(pattern=["git", "reflog", "delete"], decision="forbidden")
prefix_rule(pattern=["git", "prune"], decision="forbidden")
prefix_rule(pattern=["git", "gc", "--prune"], decision="forbidden")
prefix_rule(pattern=["git", "gc", "--prune=now"], decision="forbidden")
prefix_rule(pattern=["git", "filter-branch"], decision="forbidden")
prefix_rule(pattern=["git", "filter-repo"], decision="forbidden")
prefix_rule(pattern=["git", "push", "-f"], decision="forbidden")
prefix_rule(pattern=["git", "push", "--force"], decision="forbidden")
prefix_rule(pattern=["git", "push", "--force-with-lease"], decision="forbidden")
prefix_rule(pattern=["git", "push", "--force-if-includes"], decision="forbidden")
